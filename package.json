{
  "name": "cuekeeper",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic desktop test recording and replay",
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "cuekeeper": "dist/cli.js" },
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsc && node scripts/schemas.mjs --check",
    "schemas:write": "tsc && node scripts/schemas.mjs --write",
    "test": "node --test test/*.test.mjs",
    "build:recorder": "sh scripts/build-recorder.sh"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.41",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}

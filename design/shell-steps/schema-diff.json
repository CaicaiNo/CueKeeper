  "schemas/report.schema.json": [
    {
      "op": "test",
      "path": "/properties/entries/items/anyOf/1/properties/kind/anyOf/0/const",
      "value": "click"
    },
    {
      "op": "test",
      "path": "/properties/entries/items/anyOf/2/properties/kind/const",
      "value": "assert"
    },
    {
      "op": "add",
      "path": "/definitions",
      "value": {
        "shellOutput": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["text", "binary", "omitted"] },
            "bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "truncated": { "type": "boolean" },
            "text": { "type": "string", "minLength": 0, "maxLength": 16384, "pattern": "^[^\\u0000]*$" }
          },
          "required": ["kind", "bytes", "truncated"],
          "if": { "properties": { "kind": { "type": "string", "const": "text" } } },
          "then": { "required": ["text"] },
          "else": { "not": { "anyOf": [{ "required": ["text"] }] } }
        },
        "shellResult": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["argv", "shell"] },
            "privilege": { "type": "string", "enum": ["user", "sudo"] },
            "execution": {
              "type": "string",
              "enum": ["preview", "not-run", "finished", "terminated", "unknown"]
            },
            "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
            "signal": { "type": "string", "pattern": "^SIG[A-Z0-9]+$" },
            "cleanup": { "type": "string", "enum": ["complete", "unknown"] },
            "stdout": { "$ref": "#/definitions/shellOutput" },
            "stderr": { "$ref": "#/definitions/shellOutput" },
            "warnings": {
              "type": "array",
              "maxItems": 1,
              "items": { "type": "string", "const": "SHELL_OUTPUT_TRUNCATED" }
            }
          },
          "required": ["mode", "privilege", "execution"],
          "allOf": [
            { "not": { "required": ["exitCode", "signal"] } },
            {
              "if": { "properties": { "execution": { "enum": ["preview", "not-run"] } } },
              "then": {
                "not": {
                  "anyOf": [
                    { "required": ["exitCode"] },
                    { "required": ["signal"] },
                    { "required": ["cleanup"] },
                    { "required": ["stdout"] },
                    { "required": ["stderr"] },
                    { "required": ["warnings"] }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "op": "copy",
      "from": "/properties/entries/items/anyOf/1",
      "path": "/properties/entries/items/anyOf/-"
    },
    {
      "op": "replace",
      "path": "/properties/entries/items/anyOf/3/properties/kind",
      "value": { "type": "string", "const": "shell" }
    },
    { "op": "remove", "path": "/properties/entries/items/anyOf/3/properties/delivery" },
    {
      "op": "add",
      "path": "/properties/entries/items/anyOf/3/properties/shell",
      "value": { "$ref": "#/definitions/shellResult" }
    },
    { "op": "add", "path": "/properties/entries/items/anyOf/3/required/-", "value": "shell" }
  ]

{
  "schemas/flow.schema.json": [
    {
      "op": "test",
      "path": "/properties/steps/items/anyOf/0/anyOf/4/properties/kind/const",
      "value": "assert"
    },
    {
      "op": "test",
      "path": "/properties/behaviors/items/properties/steps/items/anyOf/4/properties/kind/const",
      "value": "assert"
    },
    {
      "op": "add",
      "path": "/definitions",
      "value": {
        "shellStep": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/properties/steps/items/anyOf/0/anyOf/0/properties/id" },
            "kind": { "type": "string", "const": "shell" },
            "setup": { "$ref": "#/properties/steps/items/anyOf/0/anyOf/0/properties/setup" },
            "argv": {
              "type": "array",
              "minItems": 1,
              "maxItems": 65,
              "items": [
                { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$" }
              ],
              "additionalItems": { "type": "string", "minLength": 0, "maxLength": 4096, "pattern": "^[^\\u0000]*$" }
            },
            "shell": { "type": "boolean", "default": false },
            "command": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^[^\\u0000]*$" },
            "cwd": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]*$" },
            "env": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 32,
              "patternProperties": {
                "^(?!(?:HOME|USER|LOGNAME|TMPDIR|LANG|PATH|NODE_OPTIONS)$|(?:SUDO_|DYLD_|LD_|CUEKEEPER_))[A-Za-z_][A-Za-z0-9_]{0,63}$": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 4000,
                      "pattern": "^[^\\u0000]*$"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "secretEnv": { "type": "string", "pattern": "^CUEKEEPER_SECRET_[A-Z0-9_]{1,64}$" }
                      },
                      "required": ["secretEnv"]
                    }
                  ]
                }
              }
            },
            "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000, "default": 30000 },
            "expectedExitCode": { "type": "integer", "minimum": 0, "maximum": 255, "default": 0 },
            "privilege": { "type": "string", "enum": ["user", "sudo"], "default": "user" }
          },
          "required": ["id", "kind"],
          "oneOf": [
            {
              "required": ["argv"],
              "properties": { "shell": { "type": "boolean", "const": false } },
              "not": { "anyOf": [{ "required": ["command"] }] }
            },
            {
              "required": ["command", "shell"],
              "properties": { "shell": { "type": "boolean", "const": true } },
              "not": { "anyOf": [{ "required": ["argv"] }] }
            }
          ],
          "if": {
            "required": ["privilege"],
            "properties": { "privilege": { "type": "string", "const": "sudo" } }
          },
          "then": {
            "required": ["argv"],
            "properties": {
              "argv": {
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/Library/CueKeeper/privileged/[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
                }
              },
              "shell": { "type": "boolean", "const": false }
            },
            "not": {
              "anyOf": [
                { "required": ["command"] },
                { "required": ["cwd"] },
                { "required": ["env"] },
                { "required": ["timeoutMs"] }
              ]
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/properties/steps/items/anyOf/0/anyOf/-",
      "value": { "$ref": "#/definitions/shellStep" }
    },
    {
      "op": "add",
      "path": "/properties/behaviors/items/properties/steps/items/anyOf/-",
      "value": { "$ref": "#/definitions/shellStep" }
    }
  ],

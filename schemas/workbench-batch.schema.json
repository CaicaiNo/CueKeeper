                        },
                        {
                          "const": "locator",
                          "type": "string"
                        },
                        {
                          "const": "focus",
                          "type": "string"
                        },
                        {
                          "const": "permission",
                          "type": "string"
                        },
                        {
                          "const": "timeout",
                          "type": "string"
                        },
                        {
                          "const": "identity",
                          "type": "string"
                        },
                        {
                          "const": "driver",
                          "type": "string"
                        },
                        {
                          "const": "artifact",
                          "type": "string"
                        },
                        {
                          "const": "shell",
                          "type": "string"
                        },
                        {
                          "const": "unknown",
                          "type": "string"
                        }
                      ]
                    },
                    "code": {
                      "type": "string"
                    },
                    "stepId": {
                      "type": "string"
                    },
                    "stepKind": {
                      "type": "string"

    "format": {
      "const": "cuekeeper-workbench-batch",
      "type": "string"
    },
    "version": {
      "const": 2,
      "type": "number"
    },
    "id": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "passed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "blocked",
          "type": "string"
        },
        {
          "const": "stopped",
          "type": "string"
        }
      ]
    },
    "stopReason": {
      "anyOf": [
        {
          "const": "operator",
          "type": "string"
        },
        {
          "const": "time",
          "type": "string"
        },
        {
          "const": "complete",
          "type": "string"
        },
        {
          "const": "failure",
          "type": "string"
        }
      ]

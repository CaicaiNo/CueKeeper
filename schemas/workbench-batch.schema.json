          "durationMs": {
            "minimum": 0,
            "type": "integer"
          },
          "failure": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "category": {
                "anyOf": [
                  {
                    "const": "assertion",
                    "type": "string"
                  },
                  {
                    "const": "locator",
                    "type": "string"
                  },
                  {
                    "const": "focus",
                    "type": "string"
                  },
                  {
                    "const": "permission",
                    "type": "string"
                  },
                  {
                    "const": "timeout",
                    "type": "string"
                  },
                  {
                    "const": "identity",
                    "type": "string"
                  },
                  {
                    "const": "driver",
                    "type": "string"

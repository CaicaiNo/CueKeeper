            "properties": {
              "fromMs": {
                "minimum": 0,
                "type": "integer"
              },
              "toMs": {
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "anyOf": [
                  {
                    "const": "unchanged",
                    "type": "string"
                  },

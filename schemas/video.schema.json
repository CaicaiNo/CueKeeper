        "container",
        "width",
        "height",
        "timebase",
        "anchor",
        "sampling"
      ]
    },
    {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "kind": {
          "const": "video",
          "type": "string"
        },
        "status": {
          "const": "skipped",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "const": "CAPTURE_DISABLED",
              "type": "string"
            },
            {
              "const": "SCREEN_CAPTURE_NOT_AUTHORIZED",
              "type": "string"
            },
            {
              "const": "SCREEN_CAPTURE_LOST",
              "type": "string"
            },
            {
              "const": "WINDOW_CLOSED",
